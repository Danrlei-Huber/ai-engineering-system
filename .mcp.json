{
  "mcpServers": {
    "n8n-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "n8n-mcp"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "${N8N_API_URL:-http://localhost:5678}",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    },
    "engineering-rag": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/rag/dist/server.js"],
      "env": {
        "RAG_DATABASE_URL": "${RAG_DATABASE_URL:-postgres://rag:rag_local_only@localhost:5433/rag}",
        "OLLAMA_URL": "${OLLAMA_URL:-http://localhost:11434}",
        "RAG_EMBED_MODEL": "${RAG_EMBED_MODEL:-bge-m3}",
        "RAG_EMBED_PROVIDER": "${RAG_EMBED_PROVIDER:-ollama}"
      }
    }
  }
}
