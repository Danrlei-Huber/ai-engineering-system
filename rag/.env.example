# DEVELOPMENT CREDENTIALS ONLY. Local Docker Compose. Never reuse outside localhost.
# Read by docker compose AND by the rag CLIs and MCP server, which derive their URLs from
# these values. Variables exported in the shell take precedence over this file.
RAG_DB_USER=rag
RAG_DB_PASSWORD=rag_local_only
RAG_DB_NAME=rag
RAG_DB_PORT=5433
OLLAMA_PORT=11434
RAG_EMBED_MODEL=bge-m3
# Optional overrides for a database or Ollama that compose does not manage:
# RAG_DATABASE_URL=postgres://user:password@host:5432/dbname
# OLLAMA_URL=http://host:11434
